// CivicResolve - Municipal Grievance Management Platform
// Minimal optimized schema for planned features

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  CITIZEN
  OFFICER
  ADMIN
}

enum ComplaintStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ==========================================
// REFERENCE DATA (Minimal)
// ==========================================

model Department {
  id    String  @id @default(cuid())
  name  String
  email String?
  phone String?

  headId     String?     @map("head_id")
  head       User?       @relation("DeptHead", fields: [headId], references: [id])
  officers   User[]      @relation("DeptOfficers")
  complaints Complaint[]

  @@map("departments")
}

model Category {
  id   String @id
  name String
  icon String

  complaints Complaint[]

  @@map("categories")
}

model Ward {
  id   String @id @default(cuid())
  name String
  zone String // e.g. "Zone 3"

  complaints Complaint[]

  @@map("wards")
}

// ==========================================
// USERS
// ==========================================

model User {
  id           String @id @default(cuid())
  email        String @unique
  phone        String @unique
  passwordHash String @map("password_hash")
  name         String
  role         Role   @default(CITIZEN)

  departmentId String?     @map("department_id")
  department   Department? @relation("DeptOfficers", fields: [departmentId], references: [id])

  complaintsCreated  Complaint[]    @relation("CitizenComplaints")
  complaintsAssigned Complaint[]    @relation("AssignedOfficer")
  headOfDepartment   Department[]   @relation("DeptHead")
  notifications      Notification[]
  feedback           Feedback[]

  @@map("users")
}

// ==========================================
// COMPLAINTS
// ==========================================

model Complaint {
  id            String          @id @default(cuid())
  displayId     String          @unique @map("display_id")
  citizenId     String          @map("citizen_id")
  categoryId    String          @map("category_id")
  subcategoryId String          @map("subcategory_id")
  description   String
  status        ComplaintStatus @default(PENDING)
  priority      Priority        @default(MEDIUM)

  // Location (needed for features: auto-assignment, heatmap, duplicate detection)
  address   String?
  latitude  Decimal?
  longitude Decimal?
  wardId    String?  @map("ward_id")

  // Assignment
  departmentId      String? @map("department_id")
  assignedOfficerId String? @map("assigned_officer_id")

  // SLA (needed for escalation, breach detection, dashboard metrics)
  slaDeadline DateTime? @map("sla_deadline")

  // Media (needed for photo evidence)
  images String[] @default([])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  // Relations
  citizen         User                @relation("CitizenComplaints", fields: [citizenId], references: [id])
  category        Category            @relation(fields: [categoryId], references: [id])
  department      Department?         @relation(fields: [departmentId], references: [id])
  ward            Ward?               @relation(fields: [wardId], references: [id])
  assignedOfficer User?               @relation("AssignedOfficer", fields: [assignedOfficerId], references: [id])
  timeline        ComplaintTimeline[]
  feedback        Feedback[]

  @@index([status])
  @@index([citizenId])
  @@index([departmentId])
  @@index([createdAt])
  @@map("complaints")
}

// Audit trail for complaint status changes (needed for: status tracking, escalation history, citizen updates)
model ComplaintTimeline {
  id          String   @id @default(cuid())
  complaintId String   @map("complaint_id")
  status      String // e.g. "assigned", "in_progress"
  message     String // e.g. "Assigned to Officer John"
  createdAt   DateTime @default(now()) @map("created_at")

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("complaint_timeline")
}

// ==========================================
// NOTIFICATIONS & FEEDBACK
// ==========================================

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String // e.g. "status_update", "assignment"
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Feedback {
  id          String   @id @default(cuid())
  complaintId String   @map("complaint_id")
  citizenId   String   @map("citizen_id")
  rating      Int // 1-5
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")

  complaint Complaint @relation(fields: [complaintId], references: [id])
  citizen   User      @relation(fields: [citizenId], references: [id])

  @@map("feedback")
}
